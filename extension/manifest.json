{
  "manifest_version": 3,
  "name": "NJDict",
  "version": "3.0",
  "description": "Bôi đen từ tiếng Nhật trên web hoặc PDF để tra nghĩa ngay: từ vựng, âm Hán Việt, sổ tay và ôn tập.",
  "permissions": [
    "contextMenus",
    "tabs",
    "storage",
    "scripting",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://mazii.net/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NJDict — tra từ tiếng Nhật"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "Mở popup NJDict (đọc từ đang bôi đen hoặc vừa Ctrl+C)"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}