# ─────────────────────────────────────────────
#  NJDict — .gitignore
# ─────────────────────────────────────────────

# --- Node / Capacitor (app Android) ---
node_modules/
npm-debug.log*

# --- Android / Gradle (file build tu sinh) ---
.gradle/
**/build/
*.apk
*.aab
local.properties
*.keystore
*.jks

# --- Goi phat hanh ---
*.zip

# --- Rac cua he dieu hanh ---
# desktop.ini rat dang luu y: Windows tu tao no trong thu muc, va Chrome tu choi
# nap extension co file nay ("The filename is illegal"). update.bat co buoc don.
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Bi mat ---
.env
.env.*
secrets.json
